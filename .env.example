# Copier ce fichier vers .env et adapter les valeurs
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=changez-moi-en-production-long-random-string

# MySQL (PyMySQL) — format : mysql+pymysql://USER:MOTDEPASSE@HOST:PORT/NOM_BASE?charset=utf8mb4
# Mot de passe vide : mysql+pymysql://root:@localhost:3306/ma_base?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/bh_service_desk?charset=utf8mb4

# Dossier uploads (relatif au projet)
UPLOAD_FOLDER=uploads

# IA similarité tickets
AI_SIMILARITY_ENABLED=true
AI_SIMILARITY_MIN_SCORE=0.30
AI_SIMILARITY_SAME_CATEGORY_ONLY=true
AI_MAX_CORPUS_TICKETS=500
